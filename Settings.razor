@page "/settings"
@inject ProjectStore Store
@inject IJSRuntime JS

<PageTitle>ตั้งค่า — CCDS Simulator</PageTitle>

<div class="page-wrap narrow">
    <div class="page-head">
        <div>
            <h1>ค่าตั้งต้นสำหรับโครงการใหม่</h1>
            <p class="muted">ตั้งราคาน้ำยา ราคาผง ค่าน้ำ ค่าไฟ ค่า PM ฯลฯ ของคุณเองไว้ที่นี่ ทุกโครงการใหม่จะใช้ค่าเหล่านี้
                (เก็บในเบราว์เซอร์นี้เท่านั้น ไม่กระทบโครงการที่สร้างไว้แล้ว)</p>
        </div>
        <div class="head-actions">
            <span class="saved">@(saved is null ? "" : $"บันทึกแล้ว {saved:HH:mm:ss}")</span>
            <button class="btn" @onclick="Reset">คืนค่าจากโรงงาน</button>
        </div>
    </div>
    @if (defaults is not null)
    {
        <InputForm Input="defaults" ShowProjectSections="false" OnChange="Save" />
    }
</div>

@code {
    private CcdsInput? defaults;
    private DateTime? saved;

    protected override async Task OnInitializedAsync() => defaults = await Store.GetDefaultsAsync();

    private async Task Save()
    {
        await Store.SaveDefaultsAsync(defaults!);
        saved = DateTime.Now;
    }

    private async Task Reset()
    {
        if (!await JS.InvokeAsync<bool>("ccds.confirm", "คืนค่าตั้งต้นทั้งหมดเป็นค่าจากโรงงาน?")) return;
        defaults = Presets.FactoryDefaults();
        await Save();
    }
}
