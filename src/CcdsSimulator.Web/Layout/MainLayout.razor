@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject UserSession Session
@inject NavigationManager Nav

<header class="nav">
    <a class="brand" href="">
        <span class="logo">CCDS</span>
        <span class="t">Feasibility <small>Simulator</small></span>
    </a>
    <div class="nav-right">
        @if (Session.Current is not null)
        {
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">สถานที่</NavLink>
            <NavLink href="dashboard">เปรียบเทียบ</NavLink>
            <NavLink href="dialysate">คำนวณน้ำยา</NavLink>
            <NavLink href="settings">ตั้งค่า</NavLink>
        </nav>
        }
        <div class="theme" role="group" aria-label="ธีม">
            <button class="@(theme == "light" ? "on" : "")" title="โหมดสว่าง" aria-label="โหมดสว่าง" @onclick='() => SetTheme("light")'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
            <button class="@(theme == "dark" ? "on" : "")" title="โหมดมืด" aria-label="โหมดมืด" @onclick='() => SetTheme("dark")'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            </button>
            <button class="@(theme == "auto" ? "on" : "")" title="อัตโนมัติ (สว่าง/มืดตามการตั้งค่าของเครื่อง)" aria-label="อัตโนมัติ" @onclick='() => SetTheme("auto")'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none" /></svg>
            </button>
        </div>
        @if (Session.Current is { } me)
        {
            <div class="user-wrap" @onfocusout="CloseUserSoon" @onfocusin="() => userClose?.Cancel()">
                <button type="button" class="user-chip" @onclick="() => userOpen = !userOpen" aria-haspopup="menu" title="ผู้ใช้: @me.Name">
                    <span class="avatar sm" style="--h:@UserGate.Hue(me.Id)">@UserGate.Initial(me.Name)</span>
                    <span class="uc-name">@me.Name</span>
                </button>
                @if (userOpen)
                {
                    <div class="menu-backdrop" @onclick="() => userOpen = false"></div>
                    <div class="menu user-menu" role="menu">
                        <div class="um-head">ผู้ใช้: <b>@me.Name</b></div>
                        <a role="menuitem" href="settings" @onclick="() => userOpen = false"><b>ตั้งค่าผู้ใช้ / PIN</b><small>เปลี่ยนชื่อ ตั้ง PIN หรือลบผู้ใช้</small></a>
                        <button role="menuitem" @onmousedown:preventDefault="true" @onclick="Logout"><b>สลับผู้ใช้ / ออกจากระบบ</b><small>กลับไปหน้าเลือกผู้ใช้</small></button>
                    </div>
                }
            </div>
        }
    </div>
</header>

@if (!Session.Ready)
{
    <main><div class="boot">กำลังโหลด…</div></main>
}
else if (Session.Current is null)
{
    <main><UserGate /></main>
}
else
{
    <main @key="Session.Current.Id">@Body</main>
}

@code {
    private string theme = "auto";
    private bool userOpen;
    private CancellationTokenSource? userClose;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnUserChanged;
        await Session.InitAsync();
    }

    private void OnUserChanged()
    {
        userOpen = false;
        // ออกจากระบบ / ลบผู้ใช้ → กลับหน้าแรก (ไม่ค้างอยู่ที่หน้าสถานที่ของผู้ใช้คนก่อน)
        if (Session.Current is null && Nav.ToBaseRelativePath(Nav.Uri).Length > 0) Nav.NavigateTo("");
        InvokeAsync(StateHasChanged);
    }
    public void Dispose() => Session.Changed -= OnUserChanged;

    private async Task Logout() { userOpen = false; await Session.LogoutAsync(); }

    private async Task CloseUserSoon()
    {
        userClose?.Cancel();
        userClose = new CancellationTokenSource();
        try { await Task.Delay(150, userClose.Token); userOpen = false; StateHasChanged(); }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        theme = await JS.InvokeAsync<string>("ccds.getTheme");
        StateHasChanged();
    }

    private async Task SetTheme(string t)
    {
        theme = t;
        await JS.InvokeVoidAsync("ccds.setTheme", t);
    }
}
