@* กราฟแท่งแนวตั้ง Cost Saving สะสมรายปี — ใช้ทั้งในรายงาน A4 และแผงผลลัพธ์หน้าแก้ไข *@
@{
    const decimal H = 110;
    var r = Result;
    decimal maxPos = Math.Max(0, r.Years.Max(y => y.Cumulative));
    decimal maxNeg = Math.Max(0, -r.Years.Min(y => y.Cumulative));
    decimal span = maxPos + maxNeg == 0 ? 1 : maxPos + maxNeg;
    decimal hPos = maxPos / span * H, hNeg = H - hPos;
    bool dense = r.Years.Count > 12;
}
<div class="ychart">
    <div class="cols-y">
        @foreach (var y in r.Years)
        {
            var bar = Math.Max(Math.Abs(y.Cumulative) / span * H, 0.8m);
            bool lease = y.Year <= r.Input.InstallmentYears;
            // เกิน 12 ปี: แสดงป้ายทุก 5 ปี (และปีแรก/ปีสุดท้าย) ไม่ให้ตัวเลขซ้อนกัน
            var label = !dense || y.Year % 5 == 0 || y.Year == r.Years.Count || y.Year == 1;
            // ไล่สี: ปลายแท่งอ่อน → ฐานเข้ม (ช่วงผ่อนเครื่องใช้โทนอ่อนกว่า)
            var color = y.Cumulative >= 0
                ? (lease ? "linear-gradient(180deg,#a7e3c0,#4cb97a)" : "linear-gradient(180deg,#5fd496,#15803d)")
                : (lease ? "linear-gradient(0deg,#f9c2c2,#ef7b7b)" : "linear-gradient(0deg,#f59a9a,#c62828)");
            <div class="yc">
                @if (hPos > 0.5m)
                {
                    <div class="zone p" style="height:@Px(hPos)">@if (y.Cumulative > 0) { <div style="height:@Px(bar);background:@color"></div> }</div>
                }
                <div class="zero"></div>
                @if (hNeg > 0.5m)
                {
                    <div class="zone n" style="height:@Px(hNeg)">@if (y.Cumulative < 0) { <div style="height:@Px(bar);background:@color"></div> }</div>
                }
                <div class="lab">@(label ? (dense ? y.Year.ToString() : $"ปี {y.Year}") : "")</div>
                <div class="val @Cls(y.Cumulative)">@(label ? Short(y.Cumulative) : "")</div>
            </div>
        }
    </div>
    <div class="cap">แท่ง = ยอดสะสม • สีอ่อน = ช่วงผ่อนชำระ, สีเข้ม = หลังผ่อนครบ • M = ล้านบาท, K = พันบาท</div>
</div>

@code {
    [Parameter, EditorRequired] public CcdsResult Result { get; set; } = default!;

    private static string Px(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";
}
