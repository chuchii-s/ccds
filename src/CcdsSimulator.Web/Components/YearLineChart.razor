@* กราฟเส้น Cost Saving สะสมรายปี (SVG) — ใช้ในรายงาน (หน้า 1–2) และแผงผลลัพธ์หน้าแก้ไข
   เส้น/พื้นสีเขียว = ยอดสะสมเป็นบวก, สีแดง = ติดลบ • เส้นประ = ผ่อนครบ • จุดใหญ่ = ปีที่เริ่มคืนทุน *@
@{
    var r = Result;
    int h = r.Years.Count;
    var vals = new List<decimal> { 0m };
    vals.AddRange(r.Years.Select(y => y.Cumulative));
    decimal vMin = vals.Min(), vMax = vals.Max();
    decimal lo = Math.Min(0, vMin), hi = Math.Max(0, vMax);
    if (hi == lo) hi = lo + 1000;                       // ทุกปีเป็น 0 (ยังไม่มีข้อมูล) → แกนอ่านง่าย
    decimal step = Nice((hi - lo) / 4);
    lo = Math.Floor(lo / step) * step;
    hi = Math.Ceiling(hi / step) * step;
    if (hi == lo) hi = lo + step;
    // เว้นที่ให้ตัวเลขใต้จุดต่ำสุด/เหนือจุดสูงสุด ไม่ให้ทับป้ายปีหรือป้ายแถบด้านบน
    if (vMin < 0 && vMin - lo < (hi - lo) * 0.12m) lo -= step;
    if (vMax > 0 && hi - vMax < (hi - lo) * 0.08m) hi += step;
    double X(int i) => L + (W - L - R) * i / (double)Math.Max(1, h);
    double Y(decimal v) => T + (H - T - B) * (double)((hi - v) / (hi - lo));
    double y0 = Y(0);
    var pts = string.Join(" ", vals.Select((v, i) => $"{F(X(i))},{F(Y(v))}"));
    var area = $"{F(X(0))},{F(y0)} {pts} {F(X(h))},{F(y0)}";
    int n = Math.Clamp(r.Input.InstallmentYears, 1, 30);
    int? be = r.BreakEvenYear;
    double gap = (W - L - R) / Math.Max(1, h);          // ระยะห่างระหว่างปี (หน่วย viewBox)
    int k = gap >= 46 ? 1 : gap >= 23 ? 2 : 5;           // แสดงค่าทุก k ปี ไม่ให้ตัวเลขซ้อนกัน
    // เลือกปีที่แสดงตัวเลข: ปีสุดท้าย, ปีผ่อนครบ, ปีแรก, แล้วทุก k ปี — ข้ามปีที่ใกล้ป้ายที่เลือกแล้วเกินไป
    // (ปีคืนทุนแสดงเสมอ: ตัวเลขวางขวาล่างของจุด จึงไม่ชนตัวเลขปีอื่นที่อยู่เหนือจุด)
    var labeled = new SortedSet<int>();
    var order = new List<int> { h };
    if (n < h) order.Add(n);
    order.Add(1);
    for (int y = k; y <= h; y += k) order.Add(y);
    foreach (var y in order)
        if (y >= 1 && y <= h && labeled.All(o => Math.Abs(X(o) - X(y)) >= 40)) labeled.Add(y);
    bool showWr = WarrantyYear is int wy0 && wy0 > 0 && wy0 < h && wy0 != n;
    bool allYears = gap >= 18;                           // ป้ายปีแสดงครบทุกปีถ้ามีที่พอ
    bool shortYr = gap < 40;                             // ที่แคบ: "3" แทน "ปี 3"
    var id = "lc" + GetHashCode().ToString("x");
}
<div class="ylc">
    <svg viewBox="0 0 @W @H" role="img" aria-label="กราฟเส้น Cost Saving สะสมรายปี">
        <defs>
            @if (Paper)
            {
                @* กระดาษ A4 (พื้นขาวเสมอ): ใช้สีทึบที่ผสมขาวไว้แล้ว — บางเบราว์เซอร์ (Safari / ตอนพิมพ์ / แปลง JPG-PDF)
                   ไม่สนใจ stop-opacity จนพื้นกราฟเป็นสีทึบเข้ม *@
                <linearGradient id="@(id)g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="@OnWhite(0x22, 0xa3, 0x5a, .28)" style="stop-opacity:1" /><stop offset="1" stop-color="@OnWhite(0x22, 0xa3, 0x5a, .03)" style="stop-opacity:1" /></linearGradient>
                <linearGradient id="@(id)r" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="@OnWhite(0xc6, 0x28, 0x28, .26)" style="stop-opacity:1" /><stop offset="1" stop-color="@OnWhite(0xc6, 0x28, 0x28, .03)" style="stop-opacity:1" /></linearGradient>
            }
            else
            {
                <linearGradient id="@(id)g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#22a35a" stop-opacity=".28" /><stop offset="1" stop-color="#22a35a" stop-opacity=".03" /></linearGradient>
                <linearGradient id="@(id)r" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#c62828" stop-opacity=".26" /><stop offset="1" stop-color="#c62828" stop-opacity=".03" /></linearGradient>
            }
            @* พื้น: ตัดที่ศูนย์พอดี *@
            <clipPath id="@(id)a"><rect x="0" y="0" width="@W" height="@F(y0)" /></clipPath>
            <clipPath id="@(id)b"><rect x="0" y="@F(y0)" width="@W" height="@F(H - y0)" /></clipPath>
            @* เส้น: ที่อยู่บนศูนย์พอดีนับเป็นสีเขียว (เส้นหนา 2.6 → เลื่อนขอบตัดลงครึ่งหนึ่ง ไม่ให้ครึ่งล่างเป็นสีแดง) *@
            <clipPath id="@(id)la"><rect x="0" y="0" width="@W" height="@F(y0 + 1.4)" /></clipPath>
            <clipPath id="@(id)lb"><rect x="0" y="@F(y0 + 1.4)" width="@W" height="@F(H - y0)" /></clipPath>
        </defs>

        @* กระดาษ: พื้นทึบวาดก่อน แล้วแถบช่วงเวลา/เส้นตารางทับด้านบน (ยังมองเห็นผ่านพื้น) *@
        @if (Paper) { @Area(area, id) }

        @* เส้นตาราง + ค่าแกน Y *@
        @for (decimal v = lo; v <= hi + step / 2; v += step)
        {
            <line x1="@L" x2="@(W - R)" y1="@F(Y(v))" y2="@F(Y(v))" class="@(v == 0 ? "zero" : "grid")" />
            @Txt(F(L - 6), F(Y(v) + 3.5), "ax", "end", Axis(v, lo, hi))
        }

        @* แถบช่วงเวลา: ช่วงผ่อน / หลังผ่อนครบ *@
        @if (Phases)
        {
            int ln = Math.Min(n, h);
            double wl = X(ln) - X(0), wo = X(h) - X(n);
            <rect x="@F(X(0))" y="0" width="@F(wl)" height="@F(H - B)" class="ph lease" />
            @if (PhaseLabel(wl, $"ช่วงผ่อน {n} ปี", "ผ่อน") is string tl) { @Txt(F(X(0) + 6), "13", "phl lease", "start", tl) }
            @if (n < h)
            {
                <rect x="@F(X(n))" y="0" width="@F(wo)" height="@F(H - B)" class="ph own" />
                @if (PhaseLabel(wo, "ผ่อนครบ • เครื่องเป็นของลูกค้า", "ผ่อนครบ") is string to) { @Txt(F(X(n) + 6), "13", "phl own", "start", to) }
            }
        }

        @* ผ่อนครบ *@
        @if (n < h)
        {
            <line x1="@F(X(n))" x2="@F(X(n))" y1="@(Phases ? 0 : T)" y2="@(H - B)" class="mark" />
            @if (!Phases) { @Txt(F(X(n) + 4), F(T + 9), "mk", "start", "ผ่อนครบ") }
        }

        @* หมดประกัน (เริ่มมีค่าบำรุงรักษา) *@
        @if (showWr && WarrantyYear is int w)
        {
            <line x1="@F(X(w))" x2="@F(X(w))" y1="@T" y2="@(H - B)" class="mark wr" />
            @Txt(F(X(w) + 4), F(T + 9), "mk wr", "start", "หมดประกัน")
        }

        @* พื้นและเส้น (เขียวเหนือศูนย์ / แดงใต้ศูนย์) *@
        @if (!Paper) { @Area(area, id) }
        <polyline points="@pts" class="ln pos" clip-path="url(#@(id)la)" />
        <polyline points="@pts" class="ln neg" clip-path="url(#@(id)lb)" />

        @* จุด + ค่า + ปี *@
        @for (int i = 1; i <= h; i++)
        {
            var v = vals[i];
            bool isBe = be == i;
            bool label = labeled.Contains(i) || isBe;
            <circle cx="@F(X(i))" cy="@F(Y(v))" r="@(isBe ? 5.2 : 3.2)" class="pt @(v >= 0 ? "pos" : "neg") @(isBe ? "be" : "")" />
            @if (label)
            {
                @if (isBe && i > 1)
                {
                    // ปีคืนทุน: ป้าย "คืนทุนปีที่" อยู่ซ้าย → ตัวเลขวางขวาล่างของจุด (ใต้เส้นที่กำลังขึ้น)
                    @Txt(F(X(i) + 7), F(Y(v) + 15), v >= 0 ? "val pos" : "val neg", "start", Short(v))
                }
                else
                {
                    @Txt(F(X(i)), F(v >= 0 ? Y(v) - 8 : Y(v) + 15), v >= 0 ? "val pos" : "val neg", "middle", Short(v))
                }
            }
            @if (label || allYears)
            {
                @Txt(F(X(i)), F(H - B + 16), "yr", "middle", shortYr ? i.ToString() : $"ปี {i}")
            }
        }
        @if (be is int b && b <= h)
        {
            // วางป้ายไว้ซ้ายของจุด (ด้านที่เส้นลงไปทางศูนย์ จึงไม่ทับตัวเลขปีถัดไป) — ปีแรกวางขวาแทน
            bool left = b > 1 || b == h;
            // ปีแรก: ตัวเลขอยู่เหนือจุด → วางป้ายขวาล่าง (ใต้เส้นที่กำลังขึ้น)
            // ปีแรกแต่ใต้จุดไม่มีที่ (ค่าใกล้ศูนย์ = จุดอยู่ติดแกนล่าง) → วางเหนือตัวเลขของจุดแทน ไม่ให้ทับกัน
            double yb = Y(vals[b]);
            double by = left ? Math.Max(T + 9, yb + 4) : yb + 16 <= H - B - 4 ? yb + 16 : Math.Max(T + 9, yb - 21);
            @Txt(F(left ? X(b) - 9 : X(b) + 7), F(by), "beL", left ? "end" : "start", $"คืนทุนปีที่ {b}")
        }
    </svg>
    <div class="cap">เส้น = ยอด Cost Saving สะสม@(Dashes(showWr, n < h)) • จุดใหญ่ = ปีที่เริ่มคืนทุน@(shortYr ? " • แกนล่าง = ปีที่" : "") • M = ล้านบาท, K = พันบาท</div>
</div>

@code {
    [Parameter, EditorRequired] public CcdsResult Result { get; set; } = default!;

    /// <summary>ขนาด viewBox — พื้นที่แคบ (แผงผลลัพธ์/ครึ่งหน้า A4) ใช้ความกว้างน้อยลงให้ตัวอักษรไม่เล็กเกินไป</summary>
    [Parameter] public double W { get; set; } = 720;
    [Parameter] public double H { get; set; } = 220;

    /// <summary>แสดงแถบพื้นหลัง "ช่วงผ่อน / หลังผ่อนครบ" (หน้า Executive Summary)</summary>
    [Parameter] public bool Phases { get; set; }
    /// <summary>ปีที่หมดประกัน — แสดงเส้นประ "หมดประกัน" (null = ไม่แสดง)</summary>
    [Parameter] public int? WarrantyYear { get; set; }

    /// <summary>วาดบนกระดาษรายงาน A4 (พื้นขาว) — ใช้สีพื้นกราฟแบบทึบ ให้พิมพ์ / PDF / JPG ทุกเบราว์เซอร์ได้สีไล่ระดับเหมือนบนจอ</summary>
    [Parameter] public bool Paper { get; set; }

    private static RenderFragment Area(string area, string id) => @<text>
        <polygon points="@area" fill="url(#@(id)g)" clip-path="url(#@(id)a)" />
        <polygon points="@area" fill="url(#@(id)r)" clip-path="url(#@(id)b)" />
    </text>;

    /// <summary>สี (r,g,b) ความทึบ a วางบนพื้นขาว → สีทึบที่ได้ (#rrggbb)</summary>
    private static string OnWhite(int r, int g, int b, double a)
    {
        int M(int c) => (int)Math.Round(255 - a * (255 - c));
        return $"#{M(r):x2}{M(g):x2}{M(b):x2}";
    }

    private const double L = 52, R = 18, B = 26;
    private double T => Phases ? 30 : 16;

    /// <summary>ข้อความใน SVG (Razor ใช้แท็ก text เองไม่ได้ในบล็อกโค้ด)</summary>
    private static MarkupString Txt(string x, string y, string cls, string anchor, string text) =>
        new($"<text x=\"{x}\" y=\"{y}\" class=\"{cls}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(text)}</text>");

    /// <summary>ป้ายแถบช่วงเวลา: เต็ม / สั้น / ไม่แสดง ตามความกว้างแถบ (ประมาณ 5.6 หน่วยต่อตัวอักษร)</summary>
    private static string? PhaseLabel(double width, string full, string shortText) =>
        width - 10 >= full.Length * 5.6 ? full : width - 10 >= shortText.Length * 5.6 ? shortText : null;

    private static string Dashes(bool warranty, bool lease) =>
        (warranty, lease) switch
        {
            (true, true) => " • เส้นประ = หมดประกัน / ผ่อนครบ",
            (true, false) => " • เส้นประ = หมดประกัน",
            (false, true) => " • เส้นประ = ผ่อนครบ",
            _ => ""
        };

    /// <summary>ค่าแกน Y: หน่วยเดียวทั้งแกน (M / K) ทศนิยมเท่าที่จำเป็น เช่น +2.5K, +1.5M</summary>
    private static string Axis(decimal v, decimal lo, decimal hi)
    {
        if (v == 0) return "0";
        decimal m = Math.Max(Math.Abs(lo), Math.Abs(hi));
        var (div, unit) = m >= 1_000_000m ? (1_000_000m, "M") : m >= 1_000m ? (1_000m, "K") : (1m, "");
        return (v > 0 ? "+" : "-") + (Math.Abs(v) / div).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + unit;
    }

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>ระยะห่างเส้นตารางที่อ่านง่าย (1, 2, 2.5, 5 × 10ⁿ)</summary>
    private static decimal Nice(decimal raw)
    {
        if (raw <= 0) return 1;
        var p = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)raw)));
        foreach (var m in new[] { 1m, 2m, 2.5m, 5m, 10m })
            if (raw <= m * p) return m * p;
        return 10 * p;
    }
}
