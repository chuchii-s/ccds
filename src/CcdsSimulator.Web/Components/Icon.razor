@* ไอคอนเส้น 24×24 ใช้สีตามข้อความ (currentColor) — powder = กล่องกระดาษใส่ผงผสม, gallon = แกลลอนน้ำยา (หูหิ้ว + ปากเท) *@
<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @if (Name == "copy")
    {
        <rect x="8.5" y="8.5" width="12" height="12" rx="2.2" />
        <path d="M15.5 8.5V5.7a2.2 2.2 0 0 0-2.2-2.2H5.7a2.2 2.2 0 0 0-2.2 2.2v7.6a2.2 2.2 0 0 0 2.2 2.2h2.8" />
    }
    else if (Name == "trash")
    {
        <path d="M4 6.5h16" />
        <path d="M9.5 6.5V4.8a1.3 1.3 0 0 1 1.3-1.3h2.4a1.3 1.3 0 0 1 1.3 1.3v1.7" />
        <path d="M6 6.5l.9 12.4a2 2 0 0 0 2 1.9h6.2a2 2 0 0 0 2-1.9L18 6.5" />
        <path d="M10 10.5v6M14 10.5v6" />
    }
    else if (Name == "info")
    {
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5.5M12 7.6v.1" />
    }
    else if (Name == "site")
    {
        @* หมุดสถานที่ + หยดน้ำยา (โลโก้หน้า "สถานที่เสนอระบบ CCDS") *@
        <path d="M12 22s-7.5-6.2-7.5-12.3a7.5 7.5 0 0 1 15 0C19.5 15.8 12 22 12 22z" />
        <path d="M12 4.9c-2 2.3-3.3 4.1-3.3 5.7a3.3 3.3 0 0 0 6.6 0c0-1.6-1.3-3.4-3.3-5.7z" fill="currentColor" stroke="none" />
    }
    else if (Name == "users")
    {
        <circle cx="9" cy="8" r="3.5" />
        <path d="M2.5 20c.6-3.6 3.2-5.8 6.5-5.8s5.9 2.2 6.5 5.8" />
        <path d="M15.5 4.8a3.3 3.3 0 0 1 0 6.4M17.5 14.6c2.2.6 3.6 2.6 4 5.4" />
    }
    else if (Name == "lock")
    {
        <rect x="5" y="10.5" width="14" height="10" rx="2.2" />
        <path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7" />
    }
    else if (Name == "logout")
    {
        <path d="M14 4h3.5A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5H14" />
        <path d="M10 8l-4 4 4 4M6 12h10" />
    }
    else if (Name == "building")
    {
        @* อาคารศูนย์ไตเทียม / คลินิก: ตึก + หลังคา + กากบาทการแพทย์ + ประตู *@
        <path d="M2.5 21h19" />
        <path d="M4.5 21V9.2L12 4l7.5 5.2V21" />
        <path d="M12 8.4v5.2M9.4 11h5.2" stroke-width="2.2" />
        <path d="M10 21v-4h4v4" />
    }
    else if (Name == "edit")
    {
        <path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4z" />
        <path d="M13.5 6.5l4 4" />
    }
    else if (Name == "report")
    {
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
        <path d="M14 3v5h5" />
        <path d="M9 17v-3M12 17v-5M15 17v-2" />
    }
    else if (Name == "clock")
    {
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
    }
    else if (Name == "powder")
    {
        <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" />
        <path d="M4 7.5l8 4.5 8-4.5" />
        <path d="M12 12v9" />
        <path d="M8 5.25l8 4.5v3" />
    }
    else
    {
        <path d="M9.5 8V5.2a1.2 1.2 0 0 1 1.2-1.2h5.1a1.2 1.2 0 0 1 1.2 1.2V8" />
        <path d="M5 8l-.8-3.5h2.6L7.5 8" />
        <rect x="4" y="8" width="16" height="12.5" rx="2" />
    }
</svg>

@code {
    /// <summary>"site", "powder", "gallon", "copy", "trash", "info"</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
