@page "/dialysate/report"
@inject ProjectStore Store
@inject IJSRuntime JS

@* รายงาน A4 ของหน้า "คำนวณน้ำยา" — พิมพ์ / ดาวน์โหลด PDF (แบบเดียวกับรายงานสถานที่) *@

<PageTitle>คำนวณน้ำยา — รายงาน</PageTitle>

@if (input is null)
{
    <div class="page-wrap"><div class="card empty">กำลังโหลด…</div></div>
}
else
{
    <div class="subbar no-print">
        <div class="crumb"><a href="dialysate">คำนวณน้ำยา</a> / <b>รายงาน</b></div>
        <div class="head-actions">
            <a class="btn" href="dialysate">← แก้ไขข้อมูล</a>
            <button class="btn" @onclick="Print">พิมพ์</button>
            <button class="btn primary" disabled="@pdfBusy" @onclick="DownloadPdf">@(pdfBusy ? "กำลังสร้าง PDF…" : "ดาวน์โหลด PDF")</button>
        </div>
    </div>
    <div class="print-tip no-print"><b>ดาวน์โหลด PDF</b> ได้ไฟล์ A4 (คอมพิวเตอร์และมือถือ) • <b>พิมพ์</b> ใช้ส่งเครื่องพิมพ์โดยตรง</div>
    @if (!string.IsNullOrEmpty(pdfMsg)) { <div class="msg no-print report-msg">@pdfMsg</div> }
    @if (pdfRender || printDlg)
    {
        @* สำเนารายงานที่ซ่อนไว้ (ขนาด A4 จริง ไม่ย่อตามจอ) ใช้แปลงเป็น PDF *@
        <div id="pdf-src" class="jpg-src" aria-hidden="true"><DialysateReport Input="input" /></div>
    }
    <div class="report-wrap">
        <DialysateReport Input="input" />
    </div>
    <PrintDialog Visible="printDlg" SourceId="pdf-src" FileName="@(FileBase + ".pdf")" Title="@("CCDS — คำนวณปริมาณการใช้น้ำยา")" OnClose="() => printDlg = false" />
}

@code {
    public const string FileBase = "CCDS_Dialysate";
    private DialysateCalcInput? input;
    private bool pdfBusy, pdfRender, fitted;
    private string? pdfMsg;

    protected override async Task OnInitializedAsync() => input = await Store.GetDialysateAsync();

    // พิมพ์: ถ้าหน้าต่างพิมพ์ไม่ขึ้น (แอปจากไอคอนหน้าจอโฮม iOS / เบราว์เซอร์ในแอป) → เปิดทางเลือก PDF
    private bool printDlg;
    private async Task Print()
    {
        bool shown;
        try { shown = await JS.InvokeAsync<bool>("ccds.print"); } catch { shown = false; }
        if (!shown) printDlg = true;
    }

    private async Task DownloadPdf()
    {
        pdfBusy = pdfRender = true; pdfMsg = null;
        StateHasChanged();
        try
        {
            await Task.Delay(150);   // รอให้สำเนารายงานที่ซ่อนไว้วาดเสร็จ
            var result = await JS.InvokeAsync<string>("ccds.reportPdf", "pdf-src", FileBase + ".pdf", "CCDS — คำนวณปริมาณการใช้น้ำยา", "download");
            pdfMsg = result == "downloaded" ? "ดาวน์โหลด PDF แล้ว (A4)" : null;
        }
        catch (Exception ex) { pdfMsg = "สร้าง PDF ไม่สำเร็จ: " + ex.Message; }
        finally { pdfBusy = pdfRender = false; }
    }

    // หลังวาดรายงานเสร็จ: ย่อเนื้อหาที่ยาวเกินให้พอดี A4
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (input is null || fitted) return;
        fitted = true;
        await JS.InvokeVoidAsync("ccds.fitReportWhenReady", ".report-wrap");
    }
}
