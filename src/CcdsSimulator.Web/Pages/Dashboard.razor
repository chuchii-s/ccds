@page "/dashboard"
@inject ProjectStore Store

<PageTitle>สถานที่ทั้งหมด — CCDS Simulator</PageTitle>

<div class="page-wrap">
    <div class="page-head">
        <div>
            <h1>สถานที่ทั้งหมด <span class="h1-note">(สำหรับผู้ประกอบการที่มีศูนย์ไตเทียมมากกว่า 1 ศูนย์)</span></h1>
            <p class="muted">เลือกสถานที่ที่ต้องการเปรียบเทียบ (ข้อมูลจากเบราว์เซอร์นี้)</p>
        </div>
    </div>

    @if (loading)
    {
        <div class="card empty">กำลังโหลด…</div>
    }
    else if (rows.Count == 0)
    {
        <div class="card empty"><h2>ยังไม่มีสถานที่</h2><p><a href="">ไปเพิ่มสถานที่</a> แล้วกลับมาเปรียบเทียบที่นี่</p></div>
    }
    else
    {
        var sel = Selected.ToList();

        <div class="chips">
            @foreach (var x in rows)
            {
                <label class="chip @(x.On ? "on" : "")"><input type="checkbox" @bind="x.On" /> @x.P.DisplayName</label>
            }
            <button class="link" @onclick="() => rows.ForEach(x => x.On = true)">เลือกทั้งหมด</button>
        </div>

        @if (sel.Count == 0)
        {
            <div class="card empty">ยังไม่ได้เลือกสถานที่</div>
        }
        else
        {
            <div class="kpis k4">
                <div class="kpi navy"><span>สถานที่ที่เลือก</span><b>@sel.Count</b><small>คุ้มค่า (Saving เป็นบวก) @sel.Count(x => x.R.SavingPerMonth >= 0) แห่ง</small></div>
                <div class="kpi @Cls(sel.Sum(x => x.R.SavingPerMonth))"><span>รวม Cost Saving / เดือน</span><b>@Signed(sel.Sum(x => x.R.SavingPerMonth))</b><small>ช่วงผ่อนชำระ</small></div>
                <div class="kpi @Cls(sel.Sum(x => x.R.SavingHorizon))"><span>รวม Cost Saving สะสม</span><b>@Signed(sel.Sum(x => x.R.SavingHorizon))</b><small>ตามระยะเวลาวิเคราะห์ของแต่ละสถานที่</small></div>
                <div class="kpi teal"><span>Treatment รวม / เดือน</span><b>@N0(sel.Sum(x => x.P.Input.TreatmentsPerMonth))</b><small>@N0(sel.Sum(x => x.P.Input.Machines)) เครื่อง</small></div>
            </div>

            <div class="dash-grid">
                <div class="card">
                    <h3>Cost Saving / เดือน (ช่วงผ่อน)</h3>
                    @Diverging(sel, x => x.R.SavingPerMonth)
                </div>
                <div class="card">
                    <h3>Cost Saving สะสม</h3>
                    @Diverging(sel, x => x.R.SavingHorizon)
                </div>
                <div class="card wide">
                    <h3>ต้นทุนต่อ Treatment: แบบ GL เทียบ แบบ CCDS (บาท)</h3>
                    @{ var maxTx = Math.Max(1m, sel.Max(x => Math.Max(x.R.GlCostPerTreatment, x.R.CcdsCostPerTreatment))); }
                    <div class="pairs">
                        @foreach (var x in sel)
                        {
                            <div class="pair">
                                <div class="pl">@x.P.DisplayName</div>
                                <div class="pb">
                                    <div class="pbar gl" style="width:@Pc(x.R.GlCostPerTreatment / maxTx * 100)"></div><span>@N2(x.R.GlCostPerTreatment)</span>
                                </div>
                                <div class="pb">
                                    <div class="pbar cc" style="width:@Pc(x.R.CcdsCostPerTreatment / maxTx * 100)"></div><span>@N2(x.R.CcdsCostPerTreatment)</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="legend-ui"><span><i class="gl"></i>แบบ GL</span><span><i class="cc"></i>แบบ CCDS</span></div>
                </div>
            </div>

            <div class="card">
                <h3>ตารางเปรียบเทียบ <small class="muted">(คลิกหัวคอลัมน์เพื่อเรียง)</small></h3>
                <table class="tbl list">
                    <thead>
                        <tr>
                            @foreach (var c in Columns)
                            {
                                <th class="@(c.Key == "name" ? "" : "r") sortable" @onclick="() => SortBy(c.Key)">@c.Label @(sortKey == c.Key ? (asc ? "▲" : "▼") : "")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Sorted(sel))
                        {
                            <tr>
                                <td><a class="pname" href="project/@x.P.Id">@x.P.DisplayName</a></td>
                                <td class="r">@N0(x.P.Input.Machines)</td>
                                <td class="r">@N0(x.P.Input.TreatmentsPerMonth)</td>
                                <td class="r">@N0(x.R.GlNetMonth)</td>
                                <td class="r">@N0(x.R.CcdsNetMonth)</td>
                                <td class="r @Cls(x.R.SavingPerMonth)"><b>@Signed(x.R.SavingPerMonth)</b></td>
                                <td class="r @Cls(x.R.SavingPerMonthAfterLease)">@Signed(x.R.SavingPerMonthAfterLease)</td>
                                <td class="r @Cls(x.R.SavingHorizon)">@Signed(x.R.SavingHorizon) <span class="muted small">(@x.P.Input.HorizonYears ปี)</span></td>
                                <td class="r">@(x.R.BreakEvenYear is int be ? $"ปีที่ {be}" : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private class Row { public required Project P; public required CcdsResult R; public bool On = true; }

    private List<Row> rows = new();
    private bool loading = true;
    private string sortKey = "saving";
    private bool asc;

    private IEnumerable<Row> Selected => rows.Where(x => x.On);

    private static readonly (string Key, string Label)[] Columns =
    {
        ("name", "ชื่อสถานที่"), ("machines", "เครื่อง"), ("tx", "Tx/เดือน"), ("gl", "แบบ GL/เดือน"), ("ccds", "แบบ CCDS/เดือน"),
        ("saving", "Saving/เดือน"), ("after", "Saving/เดือน หลังผ่อน"), ("horizon", "สะสม"), ("be", "เริ่มกำไรสะสม"),
    };

    protected override async Task OnInitializedAsync()
    {
        rows = (await Store.GetAllAsync()).Select(p => new Row { P = p, R = CcdsCalculator.Calculate(p.Input) }).ToList();
        loading = false;
    }

    private void SortBy(string key)
    {
        asc = sortKey == key ? !asc : key == "name";
        sortKey = key;
    }

    private IEnumerable<Row> Sorted(IEnumerable<Row> src)
    {
        Func<Row, object> f = sortKey switch
        {
            "name" => x => x.P.DisplayName,
            "machines" => x => x.P.Input.Machines,
            "tx" => x => x.P.Input.TreatmentsPerMonth,
            "gl" => x => x.R.GlNetMonth,
            "ccds" => x => x.R.CcdsNetMonth,
            "after" => x => x.R.SavingPerMonthAfterLease,
            "horizon" => x => x.R.SavingHorizon,
            "be" => x => x.R.BreakEvenYear ?? int.MaxValue,
            _ => x => x.R.SavingPerMonth,
        };
        return asc ? src.OrderBy(f) : src.OrderByDescending(f);
    }

    private static string Pc(decimal v) => Math.Max(0, v).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    /// <summary>กราฟแท่งแนวนอน บวก/ลบ จากเส้นศูนย์กลาง</summary>
    private RenderFragment Diverging(List<Row> sel, Func<Row, decimal> f)
    {
        var maxAbs = Math.Max(1m, sel.Max(x => Math.Abs(f(x))));
        return @<div class="bars">
            @foreach (var x in sel.OrderByDescending(f))
            {
                var v = f(x);
                var w = Pc(Math.Abs(v) / maxAbs * 50);
                <div class="bar-row dash">
                    <span class="yr" title="@x.P.DisplayName">@x.P.DisplayName</span>
                    <div class="track"><div class="fill @Cls(v)" style="@(v >= 0 ? $"left:50%;width:{w}" : $"right:50%;width:{w}")"></div></div>
                    <span class="val @Cls(v)">@Signed(v)</span>
                </div>
            }
        </div>;
    }
}
