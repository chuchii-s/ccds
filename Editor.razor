@page "/project/{Id}"
@inject ProjectStore Store
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>@(project?.DisplayName ?? "โครงการ") — CCDS Simulator</PageTitle>

@if (project is null)
{
    <div class="page-wrap"><div class="card empty">@(loading ? "กำลังโหลด…" : "ไม่พบโครงการนี้ในเบราว์เซอร์นี้")
        @if (!loading) { <p><a href="">กลับไปหน้าโครงการ</a></p> }</div></div>
}
else
{
    var r = CcdsCalculator.Calculate(project.Input);
    var s = project.Input.ScenarioEnabled ? CcdsCalculator.Calculate(CcdsCalculator.BuildScenario(project.Input)) : null;

    <div class="subbar">
        <div class="crumb"><a href="">โครงการ</a> / <b>@project.DisplayName</b>
            <span class="saved">@(saved is null ? "" : $"บันทึกอัตโนมัติแล้ว {saved:HH:mm:ss}")</span></div>
        <div class="head-actions">
            <a class="btn primary" href="project/@project.Id/report">ดูรายงาน / พิมพ์ PDF</a>
            <button class="btn" @onclick="ExportHtml">Export HTML</button>
            <button class="btn" @onclick="SaveJson">บันทึก .json</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message)) { <div class="msg">@message</div> }

    <div class="layout">
        <section class="form">
            <InputForm Input="project.Input" Result="r" OnChange="Save" />
        </section>
        <aside class="results">
            <ResultsPanel Result="r" Scenario="s" />
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private Project? project;
    private bool loading = true;
    private DateTime? saved;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        project = await Store.GetAsync(Id);
        loading = false;
    }

    private async Task Save()
    {
        await Store.SaveAsync(project!);
        saved = DateTime.Now;
    }

    /// <summary>
    /// ชื่อไฟล์ใช้เฉพาะตัวอักษรอังกฤษ/ตัวเลข เพราะบางเบราว์เซอร์ไม่รองรับชื่อไฟล์ภาษาไทยในการดาวน์โหลด
    /// (เปลี่ยนเป็นชื่อ "download" แทน)
    /// </summary>
    private string FileBase()
    {
        var i = project!.Input;
        var parts = new[] { i.ModelName, i.Month }
            .Select(x => new string((x ?? "").Where(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_').ToArray()))
            .Where(x => x.Length > 0)
            .ToList();
        if (parts.Count == 0) parts.Add(project.Id);
        return "CCDS_" + string.Join("_", parts);
    }

    private async Task SaveJson() =>
        await JS.InvokeVoidAsync("ccds.download", FileBase() + ".json", ProjectStore.ExportOne(project!.Input), "application/json");

    /// <summary>ไฟล์ HTML ไฟล์เดียว: โปรแกรม CCDS_Simulator.html + ข้อมูลโครงการนี้ เปิดแล้วขึ้นหน้ารายงาน</summary>
    private async Task ExportHtml()
    {
        try
        {
            var template = await Http.GetStringAsync("CCDS_Simulator.html");
            var json = System.Text.Json.JsonSerializer.Serialize(project!.Input); // escape < > & ให้อยู่แล้ว
            var html = template.Replace("<!--CCDS_DATA-->",
                $"<script>window.CCDS_INPUT = {json}; window.CCDS_VIEW = \"report\";</script>");
            await JS.InvokeVoidAsync("ccds.download", $"{FileBase()}_{DateTime.Now:yyyyMMdd}.html", html, "text/html");
        }
        catch (Exception ex)
        {
            message = "สร้างไฟล์ HTML ไม่สำเร็จ: " + ex.Message;
        }
    }
}
